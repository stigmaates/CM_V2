# Copy values into /root/cm_v2/CM_V2/.env on the current production layout.
# Never commit the populated file.
APP_ENV=production
APP_VERSION=
GIT_COMMIT=

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECT_TIMEOUT=30
DB_READ_TIMEOUT=300
DB_WRITE_TIMEOUT=300

BOT_TOKEN=
BOT_USERNAME=
SECRET_KEY=
TG_PROXY_URL=
CM_BONUS_BOT_TOKEN=
CM_BONUS_ADMIN_CHAT_ID=
CM_BONUS_PROXY_URL=
TECH_ALERT_BOT_TOKEN=
TECH_ALERT_CHAT_ID=
TECH_ALERT_PROXY_URL=
TECH_SUPPORT_CHAT_ID=

ADMIN_SERVICE_RESTART_ENABLED=false
ADMIN_RESTART_SERVICES=
BACKUP_MONITOR_DIRS=/root/cm_v2/CM_V2/backups
BACKUP_MAX_AGE_HOURS=24
BALANCE_TOPUP_MAX_AMOUNT=100000
TOPUP_BONUS_MAX_AMOUNT=30000
AUTO_MAILING_TIMEZONE=Europe/Moscow

# Public uploads and private feature storage must be separate.
CLUBMODULE_UPLOAD_ROOT=/var/www/clubmodule_uploads/production
CLUBMODULE_UPLOAD_URL_PREFIX=/uploads
CLUBMODULE_UPLOAD_QUOTA_MB=25
CLUBMODULE_IMAGE_MAX_MB=5
ADMIN_FILES_ROOT=/var/lib/clubmodule/admin-drive
ADMIN_FILES_QUOTA_MB=2048
ADMIN_FILES_MAX_MB=100
ADMIN_FILES_REQUEST_MAX_MB=250
MONTHLY_REPORT_ROOT=/var/lib/clubmodule/monthly-reports
MONTHLY_REPORT_ATTRIBUTION_DAYS=7

STEAM_API_KEY=
STEAM_PUBLIC_BASE_URL=https://example.com

# Generate a fresh production-only bridge secret and refresh token.
CS2_GC_BRIDGE_URL=http://127.0.0.1:32173
CS2_GC_BRIDGE_SECRET=
CS2_GC_REFRESH_TOKEN=
CS2_GC_PORT=32173

# Optional Guest Pulse threshold overrides. Defaults are shown.
GUEST_PULSE_HISTORY_DAYS=90
GUEST_PULSE_CHURN_DAYS=60
GUEST_PULSE_HEALTHY_MIN=80
GUEST_PULSE_STABLE_MIN=60
GUEST_PULSE_AT_RISK_MIN=40
GUEST_PULSE_HIGH_RISK_MIN=20
GUEST_PULSE_HIGH_VALUE_MIN=75
GUEST_PULSE_HEALTH_DROP_ALERT_14D=-15
