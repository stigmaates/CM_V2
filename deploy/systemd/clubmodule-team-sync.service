[Unit]
Description=Cyber Bonus production team and shift sync
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/cm_v2/CM_V2
EnvironmentFile=/root/cm_v2/CM_V2/.env
ExecStart=/root/cm_v2/CM_V2/venv/bin/python scripts/sync_team.py
TimeoutStartSec=1800
