[Unit]
Description=ClubModule Stage CS2 Game Coordinator bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/cm_stage/CM_V2/services/cs2_gc
EnvironmentFile=/root/cm_stage/CM_V2/.env
ExecStart=/usr/bin/node /root/cm_stage/CM_V2/services/cs2_gc/server.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
