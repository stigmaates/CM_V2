[Unit]
Description=ClubModule Stage MySQL backup
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/cm_stage/CM_V2
Environment=ENV_FILE=/root/cm_stage/CM_V2/.env
Environment=BACKUP_DIR=/root/cm_stage/CM_V2/backups
Environment=PYTHON_BIN=/root/cm_stage/CM_V2/venv/bin/python
ExecStart=/usr/bin/bash /root/cm_stage/CM_V2/scripts/backup_mysql.sh
