[Unit]
Description=Cyber Bonus production monthly report generator
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/cm_v2/CM_V2
EnvironmentFile=/root/cm_v2/CM_V2/.env
ExecStart=/root/cm_v2/CM_V2/venv/bin/python scripts/process_monthly_reports.py --limit 2
TimeoutStartSec=1800
