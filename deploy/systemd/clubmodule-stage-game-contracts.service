[Unit]
Description=ClubModule Stage game contracts match sync
After=network-online.target clubmodule-stage-cs2-gc.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/cm_stage/CM_V2
EnvironmentFile=/root/cm_stage/CM_V2/.env
ExecStart=/root/cm_stage/CM_V2/venv/bin/python scripts/process_game_contracts.py
TimeoutStartSec=600
